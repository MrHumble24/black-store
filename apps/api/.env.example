PORT=3000

# AI Provider Configuration: openai (default) | gemini | ollama
AI_PROVIDER=openai

# OpenAI (used for "Generate with AI" in the client when AI_PROVIDER=openai)
OPENAI_API_KEY=your_openai_api_key_here

# Gemini (optional)
GEMINI_API_KEY=your_gemini_api_key_here

# Ollama (optional, set AI_PROVIDER=ollama)
OLLAMA_URL=http://localhost:11434/api/generate
OLLAMA_MODEL=qwen3-coder:30b
