PORT=3000

# AI Provider Configuration: openai (default) | gemini | ollama
# Production: use openai here — do not leave ollama unless Ollama runs on that host.
AI_PROVIDER=openai

# OpenAI — required for AI features when using OpenAI (or as fallback if Ollama is down)
OPENAI_API_KEY=your_openai_api_key_here

# Gemini (optional)
GEMINI_API_KEY=your_gemini_api_key_here

# Ollama (optional, set AI_PROVIDER=ollama)
OLLAMA_URL=http://localhost:11434/api/generate
OLLAMA_MODEL=qwen3-coder:30b
